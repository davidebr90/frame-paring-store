# Niente listing delle cartelle
Options -Indexes

# Su hosting condiviso (PHP in CGI/FastCGI) l'header Authorization
# non arriva a PHP: queste regole lo inoltrano come variabile d'ambiente.
SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# I file di supporto (prologhi con underscore) non sono endpoint
<FilesMatch "^_.*\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
