<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Contenitore del player: le view immagine/video vengono aggiunte qui -->
    <FrameLayout
        android:id="@+id/playerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true" />

    <!-- Messaggio di stato in modalità player (playlist vuota, revoca, ...) -->
    <TextView
        android:id="@+id/playerStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="#8B93A2"
        android:textSize="20sp"
        android:visibility="gone" />

    <!-- Invito discreto (20s all'avvio, solo se il permesso manca) -->
    <Button
        android:id="@+id/playerAutostartButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:text="@string/autostart_button"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Impostazioni richiamabili dal telecomando anche dopo il pairing -->
    <ScrollView
        android:id="@+id/settingsPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F00C0E11"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="48dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textColor="#E9EBEE"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/settingsState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="26dp"
                android:textColor="#8B93A2"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="620dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_server"
                    android:textColor="#8B93A2"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/settingsServerInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/server_hint"
                    android:textColor="#E9EBEE"
                    android:textColorHint="#5A6272"
                    android:textSize="16sp"
                    android:inputType="textUri"
                    android:imeOptions="actionDone"
                    android:maxLines="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <Button
                        android:id="@+id/settingsSaveButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_save"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/settingsCloseButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/settings_close" />
                </LinearLayout>

                <Button
                    android:id="@+id/settingsUnpairButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/settings_unpair" />

                <TextView
                    android:id="@+id/settingsVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:textColor="#5A6272"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/settings_hint"
                    android:textColor="#5A6272"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Pannello di setup / pairing -->
    <ScrollView
        android:id="@+id/pairingPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0C0E11"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="48dp">

            <TextView
                android:id="@+id/brandTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_title"
                android:textColor="#FFB224"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="0.2" />

            <TextView
                android:id="@+id/brandSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_subtitle"
                android:textColor="#8B93A2"
                android:textSize="15sp"
                android:layout_marginBottom="28dp" />

            <!-- Fase 1: scelta server -->
            <LinearLayout
                android:id="@+id/serverForm"
                android:layout_width="560dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/serverInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/server_hint"
                    android:textColor="#E9EBEE"
                    android:textColorHint="#5A6272"
                    android:textSize="16sp"
                    android:inputType="textUri"
                    android:imeOptions="actionDone"
                    android:maxLines="1" />

                <Button
                    android:id="@+id/pairButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/start_pairing"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Fase 2: PIN + QR in attesa di conferma -->
            <LinearLayout
                android:id="@+id/codePanel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/pinText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFB224"
                    android:textSize="72sp"
                    android:textStyle="bold"
                    android:typeface="monospace"
                    android:letterSpacing="0.3" />

                <ImageView
                    android:id="@+id/qrImage"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_marginTop="20dp"
                    android:contentDescription="@string/pairing_wait" />

                <TextView
                    android:id="@+id/pairStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/pairing_wait"
                    android:textColor="#8B93A2"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Configurazione manuale (sempre disponibile sotto) -->
            <LinearLayout
                android:layout_width="560dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="42dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/manual_title"
                    android:textColor="#E9EBEE"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/claimInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/manual_hint"
                    android:textColor="#E9EBEE"
                    android:textColorHint="#5A6272"
                    android:textSize="14sp"
                    android:inputType="textUri"
                    android:imeOptions="actionDone"
                    android:maxLines="1" />

                <Button
                    android:id="@+id/claimButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/manual_go" />
            </LinearLayout>

            <!-- Avvio automatico: visibile solo se il permesso manca (Android 10+) -->
            <LinearLayout
                android:id="@+id/autostartPanel"
                android:layout_width="560dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="42dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/autostart_title"
                    android:textColor="#E9EBEE"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/autostart_hint"
                    android:textColor="#8B93A2"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/autostartButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/autostart_button"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
